# ========================================================
# CollabX Backend Environment Configuration (Production & Local)
# ========================================================

# Application Port (Render automatically sets PORT in production)
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# Client Allowed Origin(s) for CORS & Socket.IO
# For multiple domains (e.g. Vercel prod + preview + local), separate with comma:
# CLIENT_URL=https://collabx.vercel.app,https://collabx-preview.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection String (Supabase / Render / Neon)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST].supabase.co:5432/postgres

# JWT Secret Key for token signing and validation (minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Optional: Resend API Key for Email Notifications (Invitations / Alerts)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=CollabX <onboarding@resend.dev>

# Optional: Enable verbose Socket.IO logging in development ('true' or 'false')
DEBUG_SOCKETS=false
