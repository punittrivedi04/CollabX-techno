# ========================================================
# CollabX Backend Environment Configuration (Production & Local)
# ========================================================

# Application Port (Render automatically sets PORT in production)
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# Client Allowed Origin(s) for CORS & Socket.IO
# For multiple domains (e.g. Vercel prod + preview + local), separate with comma:
# CLIENT_URL=https://collabx.vercel.app,https://collabx-preview.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection String (Supabase / Render / Neon)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST].supabase.co:5432/postgres

# JWT Secret Key for token signing and validation (minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# ========================================================
# Email Delivery Configuration (OTP, Welcome, Announcements, Invitations, Notifications)
# Uses Standard SMTP / Nodemailer (configured via SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS)
# ========================================================

# Standard SMTP / Nodemailer (e.g. Gmail App Password, SendGrid, Mailtrap, or Campus SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_SECURE=false

# Outgoing Email Sender Display Address
EMAIL_FROM=CollabX <noreply@technonjr.org>

# ========================================================
# Additional Flags & Production Runtime Controls
# ========================================================
# Optional: Set to 'true' to execute schema migrations & indexes on boot (default: false for fast boot)
RUN_DB_MIGRATIONS=false
# Optional: Set to 'true' to silence HTTP access logs (or skip health check polling)
QUIET_LOGS=false
# Optional: Enable verbose Socket.IO logging in development ('true' or 'false')
DEBUG_SOCKETS=false
# Optional: Enable slow query console logging in production ('true' or 'false')
DEBUG_DB=false
