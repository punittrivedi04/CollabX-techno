# CollabX Client Environment Configuration
# Point VITE_API_URL to your backend API endpoint (e.g., https://your-backend.onrender.com/api in production)
VITE_API_URL=http://localhost:5000/api

# Optional: Override Socket.IO server URL (defaults automatically to VITE_API_URL without /api)
# VITE_SOCKET_URL=http://localhost:5000
